---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';

export const frontmatter = {
  title: 'Construction & refurbishment services | VFC Construction',
  description: 'Explore loft conversions, extensions, kitchens, bathrooms, flooring, maintenance and landscaping in Greater London.',
  ogTitle: 'Construction & refurbishment services | VFC Construction',
  ogDescription: 'Explore loft conversions, extensions, kitchens, bathrooms, flooring, maintenance and landscaping in Greater London.',
};
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  ogTitle={frontmatter.ogTitle}
  ogDescription={frontmatter.ogDescription}
  currentPage="services"
>
  <PageIntro
    eyebrow="OUR SERVICES"
    title="From extra space<br />to the finishing touch."
    lead="One considered approach to construction, refurbishment and maintenance for London homes and commercial properties."
  />

  <div class="wrap service-details">
    <section class="service-detail" id="service-0">
      <div>
        <p class="eyebrow">01 / BUILD & TRANSFORM</p>
        <h2>Extensions & remodelling</h2>
        <p>More space. A better way to live. Thoughtful kitchen extensions, structural changes and basement projects.</p>
        <ul>
          <li>Single and double-storey extensions</li>
          <li>Kitchen extensions and structural remodelling</li>
          <li>Basements, subject to feasibility and permissions</li>
        </ul>
        <a class="button outline" href="/contact?service=Extensions%20%26%20remodelling">Discuss this service <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
      </div>
      <img src="assets/images/extension.jpg" alt="Extensions & remodelling — reference image" width="1200" height="900" loading="lazy" />
    </section>

    <section class="service-detail" id="service-1">
      <div>
        <p class="eyebrow">02 / BUILD & TRANSFORM</p>
        <h2>Loft & attic conversions</h2>
        <p>Make room above. Dormer, mansard, hip-to-gable and rooflight conversions, shaped around your property.</p>
        <ul>
          <li>Dormer and mansard conversions</li>
          <li>Hip-to-gable and rooflight / Velux layouts</li>
          <li>Insulation, access and interior finishing</li>
        </ul>
        <a class="button outline" href="/contact?service=Loft%20%26%20attic%20conversions">Discuss this service <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
      </div>
      <img src="assets/images/loft.jpg" alt="Loft & attic conversions — reference image" width="1200" height="900" loading="lazy" />
    </section>
    <section class="service-detail" id="service-2">
      <div>
        <p class="eyebrow">03 / BUILD & TRANSFORM</p>
        <h2>Kitchens & bathrooms</h2>
        <p>Spaces that work beautifully. Bespoke fitting, plumbing, tiling and carefully considered finishes.</p>
        <ul>
          <li>Bespoke kitchen design and fitting</li>
          <li>Bathroom renovation and wet rooms</li>
          <li>Plumbing, tiling and electrical coordination</li>
        </ul>
        <a class="button outline" href="/contact?service=Kitchens%20%26%20bathrooms">Discuss this service <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
      </div>
      <img src="assets/images/kitchen.jpg" alt="Kitchens & bathrooms — reference image" width="1200" height="900" loading="lazy" />
    </section>

    <section class="service-detail" id="service-3">
      <div>
        <p class="eyebrow">04 / BUILD & TRANSFORM</p>
        <h2>Flooring & carpentry</h2>
        <p>The detail underfoot. Solid and engineered wood, porcelain, laminate, carpet and precise joinery.</p>
        <ul>
          <li>Solid and engineered wood flooring</li>
          <li>Porcelain, laminate and carpet installation</li>
          <li>Precision joinery and carpentry</li>
        </ul>
        <a class="button outline" href="/contact?service=Flooring%20&%20carpentry">Discuss this service <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
      </div>
      <img src="assets/images/loft.jpg" alt="Flooring & carpentry — reference image" width="1200" height="900" loading="lazy" />
    </section>

    <section class="service-detail" id="service-4">
      <div>
        <p class="eyebrow">05 / BUILD & TRANSFORM</p>
        <h2>Maintenance & decorating</h2>
        <p>Keep your property at its best. Brickwork, painting, repairs, plumbing and electrical coordination.</p>
        <ul>
          <li>Brickwork and masonry repairs</li>
          <li>Painting and decorating</li>
          <li>Plumbing and electrical coordination</li>
        </ul>
        <a class="button outline" href="/contact?service=Maintenance%20&%20decorating">Discuss this service <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
      </div>
      <img src="assets/images/kitchen.jpg" alt="Maintenance & decorating — reference image" width="1200" height="900" loading="lazy" />
    </section>

    <section class="service-detail" id="service-5">
      <div>
        <p class="eyebrow">06 / BUILD & TRANSFORM</p>
        <h2>Gardens & landscaping</h2>
        <p>A better connection outdoors. Garden clearance, paving and considered structural redesign.</p>
        <ul>
          <li>Garden clearance and redesign</li>
          <li>Paving and hard landscaping</li>
          <li>Outdoor structural improvements</li>
        </ul>
        <a class="button outline" href="/contact?service=Gardens%20&%20landscaping">Discuss this service <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
      </div>
      <img src="assets/images/garden.jpeg" alt="Gardens & landscaping — reference image" width="1200" height="900" loading="lazy" />
    </section>
  </div>
  <section class="pale section">
    <div class="wrap split">
      <div>
        <p class="eyebrow">SEASONAL PROPERTY CARE</p>
        <h2>A warmer,<br />better-performing home.</h2>
      </div>
      <div>
        <p>Ask about insulation upgrades, window seal checks, draught exclusion and heating diagnostics. We can help identify issues and discuss appropriate specialist assessment.</p>
        <p>Ventilation and heating changes should be assessed for your property. Do not block required ventilation or combustion air supplies.</p>
        <a class="text-link" href="/faq#winter">Read our property care guidance <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <p class="eyebrow">HOW WE WORK</p>
    <h2>Clear steps. Shared expectations.</h2>
    <div class="steps">
      <article>
        <span>01</span>
        <h3>Listen & explore</h3>
        <p>A free initial consultation and feasibility survey to understand your property and priorities.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Agree the detail</h3>
        <p>A written scope, exclusions, programme and stage payment schedule before work begins.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Build & communicate</h3>
        <p>Agreed milestones, progress updates and coordinated specialist trades.</p>
      </article>
      <article>
        <span>04</span>
        <h3>Hand over with care</h3>
        <p>A final walkthrough, snagging review and relevant project documentation.</p>
      </article>
    </div>
    <p class="caption">Survey availability, pricing, payment stages, certification and any workmanship guarantee are agreed for each project in writing.</p>
  </section>

  <section class="cta wrap">
    <div>
      <p class="eyebrow">YOUR NEXT CHAPTER STARTS HERE</p>
      <h2>Let’s build something<br />you’re proud of.</h2>
    </div>
    <div>
      <p>Tell us what you have in mind.<br />We’ll help you find the way forward.</p>
      <a class="button" href="/contact">Request a free survey <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
    </div>
  </section>
</BaseLayout>
