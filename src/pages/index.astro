---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ServiceCard from '../components/ServiceCard.astro';

export const frontmatter = {
  title: 'London builders since 2004 | VFC Construction',
  description: 'Residential and commercial construction, extensions and refurbishment across Greater London. Speak to Vaildo Castro about your project.',
  ogTitle: 'London builders since 2004 | VFC Construction',
  ogDescription: 'Residential and commercial construction, extensions and refurbishment across Greater London. Speak to Vaildo Castro about your project.',
};
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  ogTitle={frontmatter.ogTitle}
  ogDescription={frontmatter.ogDescription}
  currentPage="index"
>
  <section class="hero">
    <div class="wrap hero-layout">
      <div class="hero-copy">
        <p class="eyebrow"><span class="tiny-line"></span> LONDON BUILDERS. LASTING STANDARDS.</p>
        <h1>Built on trust.<br />Finished with<br /><em>precision.</em></h1>
        <p>Exceptional spaces start with people you can trust. Construction, extensions and refurbishments across Greater London, since 2004.</p>
        <div class="hero-buttons">
          <a class="button" href="/contact">Let’s discuss your project <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
          <a class="button outline" href="/gallery">Explore our work <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
        </div>
        <div class="hero-proof">
          <span><i data-lucide="shield-check" aria-hidden="true"></i> Clear stage payments</span>
          <span><i data-lucide="handshake" aria-hidden="true"></i> Personal accountability</span>
        </div>
      </div>
      <div class="hero-image">
        <img src="assets/images/kitchen.jpg" alt="Illustrative reference: a bright kitchen with timber detailing" width="1200" height="1000" fetchpriority="high" />
        <span class="image-tag">THOUGHTFULLY BUILT. BEAUTIFULLY FINISHED.</span>
        <div class="since">
          <strong>2004</strong>
          <span>OUR FOUNDATIONS<br />IN LONDON</span>
        </div>
      </div>
    </div>
    <div class="hero-foot wrap">
      <span>RESIDENTIAL & COMMERCIAL</span>
      <span>Serving London & Greater London</span>
      <a href="#difference">Discover the VFC difference ↓</a>
    </div>
  </section>

  <section class="trust-strip">
    <div class="wrap">
      <span><i data-lucide="calendar-check" aria-hidden="true"></i> 20+ years of experience</span>
      <span><i data-lucide="file-check-2" aria-hidden="true"></i> Clear, written scopes</span>
      <span><i data-lucide="badge-pound-sterling" aria-hidden="true"></i> Agreed stage payments</span>
      <span><i data-lucide="hard-hat" aria-hidden="true"></i> Safety-led planning</span>
    </div>
  </section>
  <section id="difference" class="wrap section split">
    <div>
      <p class="eyebrow">THE VFC DIFFERENCE</p>
      <h2>Your home.<br />Your investment.<br /><span class="plum">Our responsibility.</span></h2>
    </div>
    <div>
      <p class="lead">Building work should feel like progress,<br class="desktop-only" /> not a leap of faith.</p>
      <p>Founded by Vaildo “Vavá” Castro, VFC brings a personal approach to every project. We help you understand the process, agree the details and move forward with confidence.</p>
      <div class="principles">
        <div><i data-lucide="clipboard-check" aria-hidden="true"></i><span><strong>Clarity from day one</strong>A defined scope, clear exclusions and agreed stages.</span></div>
        <div><i data-lucide="user-round-check" aria-hidden="true"></i><span><strong>A builder you can speak to</strong>Direct contact and accountable project communication.</span></div>
      </div>
      <a class="text-link" href="/about">Meet the people behind the work <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
    </div>
  </section>
  <section class="section pale">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">CRAFTSMANSHIP, INSIDE & OUT</p>
          <h2>A complete approach<br />to your property.</h2>
        </div>
        <a class="text-link" href="/services">All our services <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
      </div>
      <div class="service-grid">
        <ServiceCard
          number="01"
          title="Extensions & remodelling"
          description="More space. A better way to live. Thoughtful kitchen extensions, structural changes and basement projects."
          image="assets/images/extension.jpg"
          imageAlt="Extensions & remodelling — illustrative reference image"
          linkHref="/services#service-0"
        />
        <ServiceCard
          number="02"
          title="Loft & attic conversions"
          description="Make room above. Dormer, mansard, hip-to-gable and rooflight conversions, shaped around your property."
          image="assets/images/loft.jpg"
          imageAlt="Loft & attic conversions — illustrative reference image"
          linkHref="/services#service-1"
        />
        <ServiceCard
          number="03"
          title="Kitchens & bathrooms"
          description="Spaces that work beautifully. Bespoke fitting, plumbing, tiling and carefully considered finishes."
          image="assets/images/kitchen.jpg"
          imageAlt="Kitchens & bathrooms — illustrative reference image"
          linkHref="/services#service-2"
        />
        <ServiceCard
          number="04"
          title="Flooring & carpentry"
          description="The detail underfoot. Solid and engineered wood, porcelain, laminate, carpet and precise joinery."
          image="assets/images/loft.jpg"
          imageAlt="Flooring & carpentry — illustrative reference image"
          linkHref="/services#service-3"
        />
        <ServiceCard
          number="05"
          title="Maintenance & decorating"
          description="Keep your property at its best. Brickwork, painting, repairs, plumbing and electrical coordination."
          image="assets/images/kitchen.jpg"
          imageAlt="Maintenance & decorating — illustrative reference image"
          linkHref="/services#service-4"
        />
        <ServiceCard
          number="06"
          title="Gardens & landscaping"
          description="A better connection outdoors. Garden clearance, paving and considered structural redesign."
          image="assets/images/garden.jpeg"
          imageAlt="Gardens & landscaping — illustrative reference image"
          linkHref="/services#service-5"
        />
      </div>
      <p class="caption">Photography illustrates service types and is not presented as VFC project photography.</p>
    </div>
  </section>
  <section class="commercial section">
    <div class="wrap split">
      <div>
        <p class="eyebrow">BEYOND THE HOME</p>
        <h2>London foundations.<br />Nationwide experience.</h2>
        <p>From hospitality spaces to multi-location commercial work, our history includes complex projects with many moving parts.</p>
        <a class="button light" href="/about">Our story <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
      </div>
      <div class="project-list">
        <article>
          <span>01 / HOSPITALITY</span>
          <h3>Piccadilly Sports Café</h3>
          <p>A flagship commercial project delivered from scratch in the heart of London.</p>
        </article>
        <article>
          <span>02 / SIX UK LOCATIONS</span>
          <h3>Phantom of the Opera expansion</h3>
          <p>Bristol · Newcastle · Liverpool · Birmingham · Leeds · Manchester</p>
        </article>
      </div>
    </div>
  </section>

  <section class="wrap section split">
    <div>
      <p class="eyebrow">THE POSSIBILITIES</p>
      <h2>See the potential<br />in your space.</h2>
      <p>From the first idea to the final detail, a considered plan makes the difference. Move the slider to explore our concept comparison.</p>
      <a class="text-link" href="/gallery">Explore the project gallery <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
    </div>
    <div>
      <div class="comparison" style="--position:50%">
        <div class="comparison-state after">
          <span>AFTER · CONCEPT</span>
          <img src="/assets/images/after.jpg" class="after" alt="after" />
        </div>
        <div class="comparison-state before">
          <span>BEFORE · CONCEPT</span>
          <img src="/assets/images/before.jpg" class="before" alt="before" />
        </div>
        <div class="comparison-line" aria-hidden="true">↔</div>
        <input type="range" min="0" max="100" value="50" aria-label="Reveal conceptual before and after comparison" />
      </div>
      <p class="caption">Illustrative comparison only. Verified paired project photography is awaiting approval.</p>
    </div>
  </section>

  <section class="wrap reference-note">
    <div>
      <i data-lucide="messages-square" aria-hidden="true"></i>
      <h3>Confidence starts with a conversation.</h3>
      <p>Ask for relevant client references and project examples when we discuss your plans.</p>
    </div>
    <a class="button outline" href="/contact">Speak to Vaildo <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
  </section>

  <section class="cta wrap">
    <div>
      <p class="eyebrow">YOUR NEXT CHAPTER STARTS HERE</p>
      <h2>Let’s build something<br />you’re proud of.</h2>
    </div>
    <div>
      <p>Tell us what you have in mind.<br />We’ll help you find the way forward.</p>
      <a class="button" href="/contact">Request a free survey <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
    </div>
  </section>
</BaseLayout>
