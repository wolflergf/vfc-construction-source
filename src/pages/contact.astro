---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';

export const frontmatter = {
  title: 'Request a free survey | VFC Construction',
  description: 'Discuss your London building project with Vaildo Castro. Call 07815 710630 or prepare an enquiry by email.',
  ogTitle: 'Request a free survey | VFC Construction',
  ogDescription: 'Discuss your London building project with Vaildo Castro. Call 07815 710630 or prepare an enquiry by email.',
};
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  ogTitle={frontmatter.ogTitle}
  ogDescription={frontmatter.ogDescription}
  currentPage="contact"
>
  <PageIntro
    eyebrow="LET’s TALK ABOUT YOUR PROJECT"
    title="Your plans.<br />Our next conversation."
    lead="A new room, a complete refurbishment or a space that needs some care. Tell us what you have in mind."
  />

  <section class="wrap contact-grid">
    <div>
      <p class="eyebrow">DIRECT CONTACT. PERSONAL SERVICE.</p>
      <h2>Speak to Vaildo.</h2>
      <div class="contact-cards">
        <a href="tel:+447815710630"><i data-lucide="phone" aria-hidden="true"></i><span><small>CALL US</small>07815 710630</span><i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
        <a href="https://wa.me/447815710630"><i data-lucide="message-circle" aria-hidden="true"></i><span><small>WHATSAPP</small>Start a conversation</span><i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
        <a href="mailto:vava_london@hotmail.com"><i data-lucide="mail" aria-hidden="true"></i><span><small>EMAIL</small>vava_london@hotmail.com</span><i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
        <a href="https://www.instagram.com/vaildo_castro/"><i data-lucide="instagram" aria-hidden="true"></i><span><small>INSTAGRAM</small>@vaildo_castro</span><i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
      </div>
      <div class="service-area"><i data-lucide="map-pin" aria-hidden="true"></i>
        <h3>London & Greater London</h3>
        <p>Working across the capital.<br />Contact us to confirm your location.</p>
        <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Greater+London+UK" target="_blank" rel="noopener noreferrer">View service area on Google Maps ↗</a>
      </div>
    </div>
    <div class="form-panel">
      <h2>Request a free survey</h2>
      <p>Fill in your details to prepare an email. Your email app will open so you can review and send your enquiry.</p>
      <form id="quote-form" novalidate>
        <div id="form-errors" role="alert" tabindex="-1" hidden></div>
        <div class="form-grid">
          <div class="field"><label for="name">Full name <span aria-hidden="true">*</span></label><input id="name" name="name" type="text" required autocomplete="name" maxlength="100" aria-describedby="name-error" /><span class="field-error" id="name-error"></span></div>
          <div class="field"><label for="email">Email address <span aria-hidden="true">*</span></label><input id="email" name="email" type="email" required autocomplete="email" maxlength="254" aria-describedby="email-error" /><span class="field-error" id="email-error"></span></div>
          <div class="field"><label for="phone">Phone number <span aria-hidden="true">*</span></label><input id="phone" name="phone" type="tel" required autocomplete="tel" placeholder="07815 710630" aria-describedby="phone-error" /><span class="field-error" id="phone-error"></span></div>
          <div class="field"><label for="postcode">Postcode / borough <span aria-hidden="true">*</span></label><input id="postcode" name="postcode" type="text" required autocomplete="postal-code" maxlength="80" aria-describedby="postcode-error" /><span class="field-error" id="postcode-error"></span></div>
        </div>
        <div class="field"><label for="service">Service type *</label><select id="service" name="service" required aria-describedby="service-error"><option value="">Select a service</option><option>Extensions & remodelling</option><option>Loft & attic conversions</option><option>Kitchens & bathrooms</option><option>Flooring & carpentry</option><option>Maintenance & decorating</option><option>Gardens & landscaping</option><option>Energy efficiency & diagnostics</option><option>Commercial project</option><option>Other / not sure yet</option></select><span id="service-error" class="field-error"></span></div>
        <div class="form-grid">
          <div class="field"><label for="budget">Estimated budget</label><select id="budget" name="budget"><option>Not sure yet</option><option>Under £10,000</option><option>£10,000–£30,000</option><option>£30,000–£75,000</option><option>£75,000–£150,000</option><option>£150,000+</option></select></div>
          <div class="field"><label for="timeline">Preferred timeline</label><select id="timeline" name="timeline"><option>Flexible / exploring</option><option>As soon as practical</option><option>Within 3 months</option><option>3–6 months</option><option>6+ months</option></select></div>
        </div>
        <div class="field"><label for="description">Tell us about your project *</label><textarea id="description" name="description" rows="5" required minlength="20" maxlength="4000" placeholder="What would you like to change? Include any useful details about your property." aria-describedby="description-error"></textarea><span id="description-error" class="field-error"></span></div>
        <p class="caption">Required fields are marked *. Your details are used to respond to your enquiry.</p>
        <button type="button" data-open="privacy">Privacy policy</button><button class="button" type="submit">Prepare my enquiry <i data-lucide="arrow-up-right" aria-hidden="true"></i></button>
        <div id="email-fallback" hidden>
          <p>Your enquiry is ready. Nothing has been sent from this website.</p><a class="text-link" id="email-draft">Open email draft ↗</a>
          <p>If your email app does not open, copy this message and send it to vava_london@hotmail.com.</p>
          <textarea id="email-preview" readonly rows="8" aria-label="Prepared enquiry message"></textarea><button class="button outline" type="button" id="copy-enquiry">Copy enquiry</button>
        </div>
      </form>
    </div>
  </section>
  <section class="cta wrap">
    <div>
      <p class="eyebrow">YOUR NEXT CHAPTER STARTS HERE</p>
      <h2>Let’s build something<br />you’re proud of.</h2>
    </div>
    <div>
      <p>Tell us what you have in mind.<br />We’ll help you find the way forward.</p><a class="button" href="/contact">Request a free survey <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
    </div>
  </section>
</BaseLayout>
