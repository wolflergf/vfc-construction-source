---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="page-intro wrap">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 set:html={title} />
  {lead && <p class="lead" set:html={lead} />}
</section>