---
interface Props {
  number: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  linkHref: string;
  linkLabel?: string;
}

const {
  number,
  title,
  description,
  image,
  imageAlt,
  linkHref,
  linkLabel = 'Explore service',
} = Astro.props;
---

<article class="service-card">
  <img src={image} alt={imageAlt} width="1200" height="900" loading="lazy" />
  <div>
    <span class="service-no">{number}</span>
    <h3>{title}</h3>
    <p>{description}</p>
    <a class="text-link" href={linkHref}>
      {linkLabel} <i data-lucide="arrow-up-right" aria-hidden="true"></i>
    </a>
  </div>
</article>